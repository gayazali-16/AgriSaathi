  "cards": [
    {
      "dot": "cyan",
      "title": "Primary case path",
      "items": [
        "API orchestrates evidence → validated advice → SQLite. Responses and officer feeds return through the same API."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and scope",
      "items": [
        "Demo roles only. Gemini receives submitted photos; officer retention requires consent. State exchange is local and excludes identity and photos."
      ]
