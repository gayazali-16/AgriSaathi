APP_ENV=development
# Containers set APP_ENV=production: set a stable random SESSION_SECRET (32+ chars).
# Demo identities are public sample profiles. DEMO_MODE=false disables sign-in;
# no production identity provider is implemented.
DEMO_MODE=true
SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENWEATHER_API_KEY=
# Without this key, fetch a labelled Open-Meteo weather-model estimate at a
# district reference point. Set false to disable all no-key weather requests.
ENABLE_NO_KEY_WEATHER=true
# Enables cached public soil/satellite reference evidence. Unverified fallback
# fixtures are hidden from farmers and excluded entirely from Gemini.
ENABLE_RECORDED_OBSERVATIONS=true
DATABASE_PATH=backend/data/runtime/agrisathi.sqlite3
UPLOAD_DIR=backend/data/uploads
MAX_IMAGE_BYTES=5242880
# Docker's internal port. Local development uses uvicorn --port 8001.
PORT=8000
